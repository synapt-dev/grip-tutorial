@@ -0,0 +1,13 @@
+import pytest
+
+from demo_core.tax import with_tax_cents
+
+
+def test_eight_percent_tax():
+    assert with_tax_cents(1000) == 1080
+    assert with_tax_cents(250) == 270
+
+
+def test_negative_cents_are_refused():
+    with pytest.raises(ValueError):
+        with_tax_cents(-1)
