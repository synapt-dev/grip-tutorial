@@ -0,0 +1,8 @@
+TAX_PERCENT = 8
+
+
+def with_tax_cents(cents: int) -> int:
+    """`cents` plus TAX_PERCENT sales tax, rounded half up to the cent."""
+    if cents < 0:
+        raise ValueError("cents must be >= 0")
+    return (cents * (100 + TAX_PERCENT) + 50) // 100
