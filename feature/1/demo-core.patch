diff --git a/demo_core/pricing.py b/demo_core/pricing.py
index 0b09c77..12c4866 100644
--- a/demo_core/pricing.py
+++ b/demo_core/pricing.py
@@ -6,3 +6,15 @@ def total_cents(quantity: int) -> int:
     if quantity < 0:
         raise ValueError("quantity must be >= 0")
     return quantity * UNIT_CENTS
+
+
+BULK_AT = 10
+BULK_PERCENT = 10
+
+
+def quote_cents(quantity: int) -> int:
+    """Price with the bulk discount: BULK_PERCENT off from BULK_AT units up."""
+    cents = total_cents(quantity)
+    if quantity >= BULK_AT:
+        cents = cents * (100 - BULK_PERCENT) // 100
+    return cents
