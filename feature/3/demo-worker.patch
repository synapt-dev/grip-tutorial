diff --git a/demo_worker/batch.py b/demo_worker/batch.py
index f18160f..63bbc09 100644
--- a/demo_worker/batch.py
+++ b/demo_worker/batch.py
@@ -1,6 +1,12 @@
 from demo_core.pricing import total_cents
+from demo_web.receipt import line
 
 
 def run(quantities):
     """Price a batch of orders: one {'qty', 'cents'} row per quantity, in order."""
     return [{"qty": q, "cents": total_cents(q)} for q in quantities]
+
+
+def receipts(quantities):
+    """One receipt line per order, in the shop's receipt format."""
+    return [line(row["qty"], row["cents"]) for row in run(quantities)]
